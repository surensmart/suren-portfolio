---
import { getCollection } from 'astro:content'; import Base from '../layouts/Base.astro'; import PageIntro from '../components/PageIntro.astro'; import MediaBlock from '../components/MediaBlock.astro';
const pubs=(await getCollection('publications')).sort((a,b)=>b.data.year-a.data.year); const years=[...new Set(pubs.map(p=>p.data.year))];
const profiles=await getCollection('profiles');
---
<Base title="Publications — Dr. Surendheran K."><PageIntro eyebrow="Research" title="Publications & inquiry." text="Research spanning immersive learning, virtual reality, interaction design, and creative multimedia."/><section class="profile-links shell">{profiles.map(p=><a href={p.data.url}><span>{p.data.category}</span><strong>{p.data.name}</strong>{p.data.identifier&&<small>{p.data.identifier}</small>}<b>↗</b></a>)}</section><div class="shell filter-row"><button class="filter active" data-year="all">All</button>{years.map(y=><button class="filter" data-year={y}>{y}</button>)}</div><section class="grid shell" id="publications">{pubs.map(p=><article class="card" data-pub-year={p.data.year}><MediaBlock image={p.data.image} video_url={p.data.video_url} title={p.data.title}/><p class="eyebrow">{p.data.year} · {p.data.source}</p><h2>{p.data.title}</h2><p class="meta">{p.data.authors}</p><div class="tags">{p.data.tags.map(t=><span class="tag">{t}</span>)}</div>{p.data.link&&<p><a class="arrow-link" href={p.data.link}>Read publication ↗</a></p>}</article>)}</section><script is:inline>document.querySelectorAll('.filter').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.filter').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelectorAll('[data-pub-year]').forEach(c=>c.style.display=b.dataset.year==='all'||c.dataset.pubYear===b.dataset.year?'':'none')}));</script></Base>
