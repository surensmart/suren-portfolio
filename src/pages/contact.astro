---
import { getCollection } from 'astro:content'; import Base from '../layouts/Base.astro'; import PageIntro from '../components/PageIntro.astro'; import MediaBlock from '../components/MediaBlock.astro';
const skills=(await getCollection('specializations')).filter(x=>x.data.category==='Competency'); const certs=await getCollection('certifications'); const settings=(await getCollection('site'))[0].data;
---
<Base title="Contact — Dr. Surendheran K."><PageIntro eyebrow="Contact" title="Let’s make learning more imaginative." text="Open to research collaboration, creative technology projects, academic partnerships, and thoughtful conversations about digital media education."/><section class="contact-grid shell"><div><p class="eyebrow">Get in touch</p><div class="contact-links"><a href={`mailto:${settings.email}`}>{settings.email} ↗</a><a href={settings.linkedin}>LinkedIn ↗</a>{settings.phone&&<a href={`tel:${settings.phone.replaceAll(' ','')}`}>{settings.phone}</a>}<span>{settings.location}</span></div></div><div><p class="eyebrow">Core competencies</p><div class="list">{skills.map(s=><article><h3>{s.data.name}</h3><div class="rating" aria-label={`${s.data.rating} out of 5`}>{[1,2,3,4,5].map(n=><span class:list={['dot',n<=(s.data.rating??0)&&'on']}></span>)}</div></article>)}</div></div></section><section class="section shell"><div class="section-head"><div><p class="eyebrow">Credentials</p><h2>Certifications</h2></div></div><div class="grid">{certs.map(c=><article class="card"><MediaBlock image={c.data.image} video_url={c.data.video_url} title={c.data.name}/><p class="eyebrow">{c.data.issuing_body}</p><h2>{c.data.name}</h2>{c.data.link&&<p><a class="arrow-link" href={c.data.link}>View credential ↗</a></p>}</article>)}</div></section></Base>
