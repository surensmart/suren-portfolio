---
import { getCollection } from 'astro:content'; import Base from '../layouts/Base.astro'; import PageIntro from '../components/PageIntro.astro'; import MediaBlock from '../components/MediaBlock.astro';
const media=(await getCollection('media')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()); const ntros=await getCollection('ntros'); const engagements=(await getCollection('engagements')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="Media & Engagement — Dr. Surendheran K."><PageIntro eyebrow="Beyond the classroom" title="Media, engagement & creative research."/><section class="two-col shell"><div><p class="eyebrow">In the media</p><div class="list">{media.map(m=><article><p class="date">{m.data.type} · {m.data.date.toLocaleDateString('en',{month:'short',year:'numeric'})}</p><h3>{m.data.title}</h3><p class="meta">{m.data.outlet}</p>{m.data.link&&<a class="arrow-link" href={m.data.link}>View feature ↗</a>}<MediaBlock image={m.data.image} video_url={m.data.video_url} title={m.data.title}/></article>)}</div></div><div><p class="eyebrow">Engagements</p><div class="list">{engagements.map(e=><article><h3>{e.data.title}</h3><p class="meta">{e.data.organization}</p><p>{e.data.description}</p><MediaBlock image={e.data.image} video_url={e.data.video_url} title={e.data.title}/></article>)}</div></div></section><section class="section shell"><div class="section-head"><div><p class="eyebrow">Non-traditional research outputs</p><h2>Research you can enter, hear & experience.</h2></div></div><div class="grid">{ntros.map(n=><article class="card"><MediaBlock image={n.data.image} video_url={n.data.video_url} title={n.data.title}/><p class="eyebrow">{n.data.type} · {n.data.year}</p><h2>{n.data.title}</h2><p>{n.data.description}</p>{n.data.award_status&&<p class="date">{n.data.award_status}</p>}</article>)}</div></section></Base>
