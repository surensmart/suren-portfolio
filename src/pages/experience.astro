---
import { getCollection } from 'astro:content'; import Base from '../layouts/Base.astro'; import PageIntro from '../components/PageIntro.astro'; import MediaBlock from '../components/MediaBlock.astro';
const experience=(await getCollection('experience')).sort((a,b)=>b.data.start_date.valueOf()-a.data.start_date.valueOf());
const education=(await getCollection('education')).sort((a,b)=>b.data.end_date.valueOf()-a.data.end_date.valueOf());
const fmt=(d:Date)=>d.toLocaleDateString('en',{month:'short',year:'numeric'});
---
<Base title="Experience — Dr. Surendheran K."><PageIntro eyebrow="Experience" title="Across classrooms, studios & cultures." text="Seventeen years bridging creative production, academic leadership, and technology-enhanced learning."/><section class="timeline shell">{experience.map(x=><article><p class="date">{fmt(x.data.start_date)} — {x.data.end_date==='Present'?'Present':fmt(x.data.end_date)}</p><div><h2>{x.data.role}</h2><p class="meta">{x.data.organization}{x.data.location&&` · ${x.data.location}`}</p><ul>{x.data.bullets.map(b=><li>{b}</li>)}</ul><MediaBlock image={x.data.image} video_url={x.data.video_url} title={x.data.role}/></div></article>)}</section><section class="section shell"><div class="section-head"><div><p class="eyebrow">Education</p><h2>Foundations & continued learning.</h2></div></div><div class="grid">{education.map(x=><article class="card"><MediaBlock image={x.data.image} video_url={x.data.video_url} title={x.data.degree}/><p class="eyebrow">{x.data.start_date.getFullYear()} — {x.data.end_date.getFullYear()}</p><h2>{x.data.degree}</h2><p class="meta">{x.data.institution} · {x.data.location}</p>{x.data.description&&<p>{x.data.description}</p>}</article>)}</div></section></Base>
