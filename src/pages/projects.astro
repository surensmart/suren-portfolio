---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import MediaBlock from '../components/MediaBlock.astro';
const projects=(await getCollection('projects')).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured)||b.data.year-a.data.year);
const categories=[...new Set(projects.map(p=>p.data.category))];
---
<Base title="Projects — Dr. Surendheran K.">
  <PageIntro eyebrow="Portfolio" title="Creative work, teaching experiments & immersive ideas." text="A growing archive of installations, learning design, and digital media practice."/>
  <div class="shell collection-tools">
    <label class="collection-search">⌕ <input type="search" placeholder="Search projects" aria-label="Search projects"/></label>
    <div class="filter-row"><button class="filter active" data-type="all">All</button>{categories.map(c=><button class="filter" data-type={c}>{c}</button>)}</div>
  </div>
  <section class="grid shell filterable-grid">
    {projects.map(p=><article class="card project-card" data-project-type={p.data.category} data-search={`${p.data.title} ${p.data.summary} ${p.data.tags.join(' ')}`.toLowerCase()}>
      {p.data.image||p.data.video_url?<MediaBlock image={p.data.image} video_url={p.data.video_url} title={p.data.title}/>:<div class="project-visual">{p.data.title.split(' ').map(w=>w[0]).slice(0,2).join('')}</div>}
      <div class="card-body"><p class="eyebrow">{p.data.category} · {p.data.year}</p><h2>{p.data.title}</h2><p>{p.data.summary}</p><div class="tag-cloud">{p.data.tags.map(t=><span class="tag">{t}</span>)}</div>{p.data.link&&<p><a class="arrow-link" href={p.data.link}>Visit project ↗</a></p>}</div>
    </article>)}
  </section>
  <p class="shell no-results" hidden>No projects match that search.</p>
  <script is:inline>
    const initProjects=()=>{
      const input=document.querySelector('.collection-search input');
      const cards=[...document.querySelectorAll('[data-project-type]')];
      const empty=document.querySelector('.no-results');
      if(!input||input.dataset.ready)return;
      input.dataset.ready='true';
      let type='all';
      const update=()=>{
        const query=input.value.toLowerCase().trim();let shown=0;
        cards.forEach(card=>{const match=(type==='all'||card.dataset.projectType===type)&&(!query||card.dataset.search.includes(query));card.hidden=!match;if(match)shown++});
        empty.hidden=shown>0;
      };
      document.querySelectorAll('.filter[data-type]').forEach(button=>button.addEventListener('click',()=>{
        document.querySelectorAll('.filter[data-type]').forEach(item=>item.classList.remove('active'));
        button.classList.add('active');type=button.dataset.type;update();
      }));
      input.addEventListener('input',update);
    };
    initProjects();document.addEventListener('astro:page-load',initProjects);
  </script>
</Base>
