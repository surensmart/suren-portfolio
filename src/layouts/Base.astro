---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
interface Props { title: string; description?: string; }
const { title, description = 'Portfolio of Dr. Surendheran K., digital media educator, researcher, and creative technologist.' } = Astro.props;
const path = Astro.url.pathname;
const settings = (await getCollection('site'))[0].data;
const nav = [['/','Home'],['/experience','Experience'],['/teaching','Teaching'],['/publications','Publications'],['/grants-awards','Grants & awards'],['/projects','Projects'],['/media','Media'],['/contact','Contact']];
const searchable = [
  ...(await getCollection('publications')).map(x=>({title:x.data.title, detail:`${x.data.year} · ${x.data.source}`, category:'Publications', href:'/publications'})),
  ...(await getCollection('projects')).map(x=>({title:x.data.title, detail:x.data.summary, category:'Projects', href:'/projects'})),
  ...(await getCollection('experience')).map(x=>({title:x.data.role, detail:x.data.organization, category:'Experience', href:'/experience'})),
  ...(await getCollection('awards')).map(x=>({title:x.data.title, detail:x.data.body, category:'Awards', href:'/grants-awards'})),
  ...(await getCollection('grants')).map(x=>({title:x.data.title, detail:x.data.funder, category:'Grants', href:'/grants-awards'})),
  ...(await getCollection('media')).map(x=>({title:x.data.title, detail:x.data.outlet, category:'Media', href:'/media'}))
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" />
  <title>{title}</title>
  <ClientRouter />
  <script is:inline>document.documentElement.dataset.theme=localStorage.getItem('theme')||'light';</script>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/" aria-label={`${settings.name} home`}><span>SK</span><span>{settings.name}</span></a>
    <div class="header-actions"><button class="icon-button search-open" aria-label="Search site">⌕</button><button class="icon-button theme-toggle" aria-label="Switch colour theme">◐</button><button class="menu" aria-label="Toggle navigation" aria-expanded="false"><span></span><span></span><span></span></button></div>
    <nav aria-label="Primary navigation">{nav.map(([href,label]) => <a href={href} class:list={[path === href && 'active']}>{label}</a>)}</nav>
  </header>
  <dialog class="search-dialog"><div class="search-panel"><div class="search-top"><span>⌕</span><input type="search" placeholder="Search publications, projects, awards…" aria-label="Search site"/><button class="search-close" aria-label="Close search">×</button></div><div class="search-filters"><button class="active" data-category="All">All</button>{[...new Set(searchable.map(x=>x.category))].map(c=><button data-category={c}>{c}</button>)}</div><div class="search-results" aria-live="polite"></div><p class="search-hint">Start typing to explore the portfolio.</p></div><script type="application/json" id="search-data" set:html={JSON.stringify(searchable).replace(/</g,'\\u003c')} /></dialog>
  <main><slot /></main>
  <footer><p>{settings.name} · Digital media educator, researcher & creative technologist</p><p><a href={`mailto:${settings.email}`}>Email</a> · <a href={settings.linkedin}>LinkedIn</a></p></footer>
  <script is:inline>
    const init=()=>{const b=document.querySelector('.menu'),n=document.querySelector('header nav');b?.addEventListener('click',()=>{const o=n?.classList.toggle('open');b.classList.toggle('active',!!o);b.setAttribute('aria-expanded',String(!!o))});n?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{n.classList.remove('open');b?.classList.remove('active')}));document.querySelector('.theme-toggle')?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=next;localStorage.setItem('theme',next)});const dialog=document.querySelector('.search-dialog'),input=dialog?.querySelector('input'),results=dialog?.querySelector('.search-results'),hint=dialog?.querySelector('.search-hint');let category='All',data=[];try{data=JSON.parse(document.querySelector('#search-data')?.textContent||'[]')}catch{}const render=()=>{const q=(input?.value||'').toLowerCase().trim();const found=data.filter(x=>(category==='All'||x.category===category)&&(!q||`${x.title} ${x.detail} ${x.category}`.toLowerCase().includes(q))).slice(0,12);if(results)results.innerHTML=found.map(x=>`<a href="${x.href}"><span>${x.category}</span><strong>${x.title}</strong><small>${x.detail||''}</small><b>→</b></a>`).join('');if(hint)hint.hidden=!!found.length};document.querySelector('.search-open')?.addEventListener('click',()=>{dialog?.showModal();setTimeout(()=>input?.focus(),50);render()});dialog?.querySelector('.search-close')?.addEventListener('click',()=>dialog.close());dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});input?.addEventListener('input',render);dialog?.querySelectorAll('[data-category]').forEach(btn=>btn.addEventListener('click',()=>{dialog.querySelectorAll('[data-category]').forEach(x=>x.classList.remove('active'));btn.classList.add('active');category=btn.dataset.category;render()}));
    document.querySelectorAll('a[href]').forEach((link) => {
      const href = link.getAttribute('href');
      if (!href || href.startsWith('/') || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;
      try {
        const url = new URL(href, window.location.href);
        if (url.origin !== window.location.origin) {
          link.setAttribute('target', '_blank');
          link.setAttribute('rel', 'noopener noreferrer');
          link.setAttribute('data-external', 'true');
        }
      } catch {}
    });};document.addEventListener('astro:page-load',init);
  </script>
</body></html>
